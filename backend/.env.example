# Core
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/midnight_tavern
REDIS_URL=redis://localhost:6379/0
# IMPORTANT: rotating SECRET_KEY invalidates every encrypted provider key in the DB.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173
DEBUG=true

# Dungeon Master AI
ANTHROPIC_API_KEY=
DM_DEFAULT_MODEL=claude-haiku-4-5-20251001

# Image generation
# Comma-separated provider order; first available wins. Use "dummy" for local dev/testing.
IMAGE_PROVIDER_ORDER=dummy,runware,wavespeed,fal,together
IMAGES_STORAGE_DIR=./var/images
IMAGE_PROMPT_SUMMARIZER_ENABLED=false
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3

# Image provider API keys (only the ones you intend to use)
RUNWARE_API_KEY=
WAVESPEED_API_KEY=
FAL_API_KEY=
TOGETHER_API_KEY=
